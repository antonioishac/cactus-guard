# URL base da API (inclui o prefixo /api/v1). Em dev o backend libera http://localhost:3000.
VITE_API_URL=http://localhost:8080/api/v1
# true = MSW intercepta a API no navegador (equivale a `npm run dev:mock`)
VITE_USE_MOCK=false
# Timeout de sessao por inatividade, em minutos (padrao 15)
VITE_IDLE_TIMEOUT_MIN=15
