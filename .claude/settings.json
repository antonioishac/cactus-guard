{
  "permissions": {
    "allow": [
      "Bash(mvn:*)",
      "Bash(JAVA_HOME=/c/Java/jdk-25.0.2 mvn:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(npm run:*)"
    ],
    "deny": [
      "Read(**/target/**)",
      "Read(**/node_modules/**)",
      "Read(**/.idea/**)",
      "Read(**/dist/**)",
      "Read(**/*.log)",
      "Read(**/.env)",
      "Read(**/.env.*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/session_context.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/py.sh\" block_secrets.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/py.sh\" protect_migrations.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/py.sh\" java_check.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
