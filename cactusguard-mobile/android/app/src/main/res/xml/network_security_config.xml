<?xml version="1.0" encoding="utf-8"?>
<!-- Release: somente HTTPS, confiando apenas nas CAs do sistema (sem CAs de usuário). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
