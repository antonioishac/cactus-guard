# Normaliza fim de linha; scripts de hook precisam de LF para rodar no Git Bash/Linux
* text=auto
*.sh text eol=lf
*.py text eol=lf
.claude/hooks/* text eol=lf
*.sql text eol=lf
*.java text eol=lf
mvnw text eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf
*.png binary
*.jpg binary
*.pdf binary
*.xlsx binary
